+// The caller has already checked the first character. Up to four decimal
+// digits fit without saturation. When enough input remains, a short prefix
+// needs just one bounds check, including for ordinary one-to-three-digit
+// parameters followed by a delimiter. Leave the first non-digit unconsumed.
+static __forceinline VTInt parseDecimalParameter(const std::wstring_view text, size_t& pos) noexcept
+{
+    VTInt value = text[pos++] - L'0';
+    if (text.size() - pos >= 3)
+    {
+        for (unsigned n = 0; n < 3; ++n)
+        {
+            const auto digit = static_cast<unsigned>(text[pos] - L'0');
+            if (digit > 9)
+            {
+                return value;
+            }
+            ++pos;
+            value = value * 10 + static_cast<VTInt>(digit);
+        }
+    }
+    while (pos < text.size())
+    {
+        const auto digit = static_cast<unsigned>(text[pos] - L'0');
+        if (digit > 9)
+        {
+            break;
+        }
+        ++pos;
+        value = std::min(value * 10 + static_cast<VTInt>(digit), MAX_PARAMETER_VALUE);
+    }
+    return value;
+}
