// Madotty — application resources.
// LANG_NEUTRAL(0), SUBLANG_NEUTRAL(0)
LANGUAGE 0, 0

#define RT_MANIFEST 1
RT_MANIFEST 24 "ghostty.manifest"

#define ID_ICON_GHOSTTY 1
ID_ICON_GHOSTTY ICON "ghostty.ico"

// Settings controls are handled in src/apprt/win32/Settings.zig.
110 DIALOGEX 0, 0, 252, 169
STYLE 0x80C808C0
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Font size (pt)", -1, 12, 15, 88, 10
    EDITTEXT 111, 108, 12, 132, 14, 0x0080
    LTEXT "&Window theme", -1, 12, 36, 88, 10
    COMBOBOX 112, 108, 33, 132, 80, 0x50210003
    LTEXT "&Tab bar", -1, 12, 57, 88, 10
    COMBOBOX 113, 108, 54, 132, 65, 0x50210003
    LTEXT "Window &opacity (%)", -1, 12, 78, 88, 10
    EDITTEXT 115, 108, 75, 132, 14, 0x0080
    CONTROL "Blur &background", 116, "Button", 0x50010003, 108, 97, 132, 12
    LTEXT "Default terminal", -1, 12, 119, 88, 10
    PUSHBUTTON "Open &Windows settings", 117, 108, 116, 132, 15
    PUSHBUTTON "&Edit config file", 114, 12, 145, 85, 14
    DEFPUSHBUTTON "Save", 1, 132, 145, 50, 14
    PUSHBUTTON "Cancel", 2, 190, 145, 50, 14
END

#pragma code_page(65001)
LANGUAGE 17, 1
118 DIALOGEX 0, 0, 252, 169
STYLE 0x80C808C0
CAPTION "設定"
FONT 9, "Yu Gothic UI"
BEGIN
    LTEXT "フォントサイズ (pt)(&F)", -1, 12, 15, 88, 10
    EDITTEXT 111, 108, 12, 132, 14, 0x0080
    LTEXT "ウィンドウのテーマ(&W)", -1, 12, 36, 88, 10
    COMBOBOX 112, 108, 33, 132, 80, 0x50210003
    LTEXT "タブバー(&T)", -1, 12, 57, 88, 10
    COMBOBOX 113, 108, 54, 132, 65, 0x50210003
    LTEXT "不透明度 (%)(&O)", -1, 12, 78, 88, 10
    EDITTEXT 115, 108, 75, 132, 14, 0x0080
    CONTROL "背景をぼかす(&B)", 116, "Button", 0x50010003, 108, 97, 132, 12
    LTEXT "既定のターミナル", -1, 12, 119, 88, 10
    PUSHBUTTON "Windows の設定を開く(&I)", 117, 108, 116, 132, 15
    PUSHBUTTON "設定ファイルを編集(&E)", 114, 12, 145, 85, 14
    DEFPUSHBUTTON "保存", 1, 132, 145, 50, 14
    PUSHBUTTON "キャンセル", 2, 190, 145, 50, 14
END

LANGUAGE 0, 0

// Version info — shown in Explorer's Properties → Details and used by
// signtool / installer tooling. The numbers here are baseline; the
// actual build-time version comes from build_config.version, but the
// PE resource needs static values at link time.
//
// Update FILEVERSION/PRODUCTVERSION when bumping for a release. The
// commas in the comma-form are 16-bit fields: MAJOR,MINOR,PATCH,BUILD.
//
// VS_VERSION_INFO must resolve to numeric resource ID 1; winres.h
// normally defines it, but this file is compiled without it, so the
// block would otherwise become a named resource that GetFileVersionInfo
// and Explorer never find.
#define VS_VERSION_INFO 1
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,4,2,0
PRODUCTVERSION 1,4,2,0
FILEFLAGSMASK  0x3F
FILEFLAGS      0x0
FILEOS         0x40004 // VOS_NT_WINDOWS32
FILETYPE       0x1     // VFT_APP
FILESUBTYPE    0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = U.S. English, 04B0 = Unicode codepage 1200
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Madotty"
            VALUE "FileDescription",  "Madotty terminal emulator"
            VALUE "FileVersion",      "1.4.2.0"
            VALUE "InternalName",     "ghostty"
            VALUE "LegalCopyright",   "Original work copyright Mitchell Hashimoto. Windows port additions copyright Shiwei Song. MIT License."
            VALUE "OriginalFilename", "ghostty.exe"
            VALUE "ProductName",      "Madotty"
            VALUE "ProductVersion",   "1.4.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
